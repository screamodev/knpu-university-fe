# Public Strapi URL (browser + default for server when NUXT_STRAPI_SERVER_URL is unset).
# Local dev on the host: http://localhost:1337
STRAPI_URL=http://localhost:1337
# Optional: same as STRAPI_URL; overrides public strapi URL when set.
# NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
#
# When Nuxt runs in Docker but Strapi is on the host or another compose project, SSR
# must call Strapi via the host from inside the container, e.g.:
# NUXT_STRAPI_SERVER_URL=http://host.docker.internal:1337
# docker-compose.dev.yml sets this for `docker compose -f docker-compose.dev.yml up`.
