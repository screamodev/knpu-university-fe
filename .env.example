# Public Directus URL (browser + default for server when NUXT_DIRECTUS_SERVER_URL is unset).
# Local dev on the host: http://localhost:8055
DIRECTUS_URL=http://localhost:8055
# Optional: same as DIRECTUS_URL; overrides public Directus URL when set.
# NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
#
# When Nuxt runs in Docker but Directus is on the host or another compose project, SSR
# must call Directus via the host from inside the container, e.g.:
# NUXT_DIRECTUS_SERVER_URL=http://host.docker.internal:8055
# docker-compose.dev.yml sets this for `docker compose -f docker-compose.dev.yml up`.
