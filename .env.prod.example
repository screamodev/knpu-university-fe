# ──────────────────────────────────────────────────────────────────────────────
# Browser-visible Directus URL. Baked into the client JS bundle at build time
# (Dockerfile.prod ARG → ENV → Vite). Changing this requires a rebuild.
# ──────────────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_DIRECTUS_URL=https://hnpu-admin.dev42hub.uk

# ──────────────────────────────────────────────────────────────────────────────
# Server-side Directus URL used during SSR. Hits the Directus container over
# the internal Docker network (webnet) — skips public DNS, TLS, and CORS, and
# is much faster than going back out through Caddy.
#
# Must match the Directus container_name in knpu-university-be/docker-compose.prod.yml.
# ──────────────────────────────────────────────────────────────────────────────
NUXT_DIRECTUS_SERVER_URL=http://knpu-university-directus:8055
